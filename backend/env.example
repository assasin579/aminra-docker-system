# CertifyAI Vietnam — Environment Variables
# Copy file này thành .env và điền thông tin thực tế

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # để trống nếu chạy local không có auth
COLLECTION_NAME=halal_kb

# ── LLM (Ollama local) ────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# Nếu server yếu hơn, dùng: qwen2.5:3b hoặc llama3.2:3b

# ── LLM Fallback (Groq — nhanh, miễn phí tier) ───────────────────────────────
GROQ_API_KEY=                          # lấy tại console.groq.com
GROQ_MODEL=llama-3.1-8b-instant

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBED_MODEL=intfloat/multilingual-e5-base
# Thay thế nếu server yếu: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=80
MIN_CHUNK_WORDS=30

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=6
SCORE_THRESHOLD=0.40

# ── API ───────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./docs
MAX_CONTEXT_TOKENS=2400
