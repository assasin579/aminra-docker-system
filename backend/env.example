# CertifyAI Vietnam — Environment Variables
# Copy file này thành .env và điền thông tin thực tế

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # để trống nếu chạy local không có auth
COLLECTION_NAME=halal_kb

# ── LLM (Ollama local) ────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# Nếu server yếu hơn, dùng: qwen2.5:3b hoặc llama3.2:3b

# ── LLM Fallback (Groq — nhanh, miễn phí tier) ───────────────────────────────
GROQ_API_KEY=                          # lấy tại console.groq.com
GROQ_MODEL=llama-3.1-8b-instant

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBED_MODEL=intfloat/multilingual-e5-base
# Thay thế nếu server yếu: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=80
MIN_CHUNK_WORDS=30

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=6
SCORE_THRESHOLD=0.40

# ── API ───────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./docs
MAX_CONTEXT_TOKENS=2400

# ── Server tuning ─────────────────────────────────────────────────────────────
# Tuned per-deployment. Production rule of thumb: WEB_CONCURRENCY ≈ 2 * CPU + 1.
WEB_CONCURRENCY=4              # gunicorn worker count
WORKER_TIMEOUT=240             # seconds — must cover slow uploads
MAX_REQUESTS=1000              # graceful restart per worker (avoid leak buildup)
MAX_REQUESTS_JITTER=100        # randomize restart so workers don't all bounce together

# ── Database pool ─────────────────────────────────────────────────────────────
# Total pool size = DB_POOL_MAX_SIZE × WEB_CONCURRENCY. Don't exceed Postgres
# max_connections (default 100). With WEB_CONCURRENCY=4 + max_size=20 = 80 conns.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_QUERIES=50000
DB_POOL_INACTIVE_LIFETIME=300  # seconds — close idle connections
DB_COMMAND_TIMEOUT=30

# ── Async job queue (Redis) ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# EMAIL_ENABLED=false → mailer logs only, không gửi mạng (an toàn cho dev/CI)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true                      # STARTTLS (true) hoặc plain (false)
SMTP_FROM_EMAIL=noreply@aminra.vn
SMTP_FROM_NAME=AMINRA
DEFAULT_EMAIL_LANG=vi                  # template fallback nếu user không có lang preference
APP_BASE_URL=http://localhost:3100     # dùng trong template để build link reset password, verify, …

# ── Keycloak (auth provider — ADR-005 Phase 1) ────────────────────────────────
# Phase 1: deploy + bootstrap. Phase 2/3 sẽ wire FE/BE.
# Production: secret qua Vault (secret/aminra/keycloak/{db_password,admin_password}).
# Dev fallback: top-level .env (KHÔNG commit).
KEYCLOAK_URL=http://keycloak:8080      # internal docker network. Public: http://localhost:8180 (dev) / https://auth.aminra.vn (prod)
KEYCLOAK_REALM=aminra
KEYCLOAK_CLIENT_ID_FRONTEND=aminra-frontend
KEYCLOAK_CLIENT_ID_BACKEND=aminra-backend
KEYCLOAK_AUDIENCE=aminra-backend       # JWT aud claim BE accepts
# Phase 3a dual-auth flag. Default off → BE chỉ accept manual HS256 JWT cũ.
# Bật =true sau khi Keycloak realm bootstrap + FE migration (Phase 2) sẵn sàng.
AUTH_KEYCLOAK_ENABLED=false
# KEYCLOAK_DB_PASSWORD và KEYCLOAK_ADMIN_PASSWORD KHÔNG đặt ở đây — dùng top-level .env
# hoặc Vault inject. Xem databases/postgres/02-keycloak-init.sh.
