# AMINRA Docker Environment Configuration
# Secrets are managed by HashiCorp Vault — see vault/scripts/init-vault.sh

# Database bootstrap (used only for initial PostgreSQL initdb)
POSTGRES_PASSWORD=your_secure_password_here

# Keycloak bootstrap — ADR-005 Phase 1
# KEYCLOAK_DB_PASSWORD: read by databases/postgres/02-keycloak-init.sh khi initdb chạy lần đầu.
#   Production runtime: rotate qua Vault (secret/aminra/keycloak/db_password) — Phase 5.
# KEYCLOAK_ADMIN_PASSWORD: admin user của Keycloak realm master. Đổi password ngay sau lần login đầu.
KEYCLOAK_DB_PASSWORD=your_secure_keycloak_db_password_here
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password_here

# CORS allowed origins (comma-separated, no spaces)
# Production default (hardcoded in app.py): https://fe.silvergem.org,https://mukjizat.silvergem.org
# Override in docker-compose.yml to add dev origins like http://localhost:3000
# CORS_ORIGINS=https://fe.silvergem.org,https://mukjizat.silvergem.org

# Sentry error tracking (optional — leave blank to disable)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ──────────────────────────────────────────────────────────────────────────────
# The following secrets are NO LONGER stored here.
# They are managed in Vault at:
#   secret/aminra/api-keys    → OPENROUTER_API_KEY, DEEPSEEK_API_KEY
#   secret/aminra/database    → POSTGRES_PASSWORD (runtime)
#   secret/aminra/auth        → JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_SECRET
# ──────────────────────────────────────────────────────────────────────────────
